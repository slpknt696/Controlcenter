---
import type { HTMLAttributes } from 'astro/types';
import { assetUrl, sitePath } from '~/lib/asset-base.js';

export interface Props extends HTMLAttributes<'nav'> {}

const { class: className, ...props } = Astro.props;
---

<nav
	aria-label="Site navigation"
	class:list={["min-h-20 !flex items-center flex-row md:justify-between py-2 bg-white", className]}
	{...props}
>
	<div class="flex-1">
		<a class="-m-2 block w-fit p-2 transition hover:text-theme-base-600" href={sitePath('/')}>
			<img src={assetUrl('/assets/brand/logo.webp')} alt="Control Center" class="h-12 w-auto object-contain" />
			<span class="sr-only">Home</span>
		</a>
	</div>
	<div class="hidden flex-1 justify-center gap-5 text-sm font-semibold uppercase text-theme-base-700 md:flex">
		<a href={sitePath('/minorista')} class="hover:text-theme-base-900">Minorista</a>
		<a href={sitePath('/mayorista')} class="hover:text-theme-base-900">Mayorista</a>
		<a href={sitePath('/servicio-tecnico')} class="hover:text-theme-base-900">Servicio tecnico</a>
		<a href={sitePath('/contacto')} class="hover:text-theme-base-900">Contacto</a>
	</div>
	<div class="flex flex-1 justify-end gap-2">
		<a href={sitePath('/carrito')} class="relative flex h-10 items-center justify-center border border-theme-base-300 px-4 text-sm font-bold uppercase transition hover:bg-theme-base-100">
			Carrito
			<span class="ml-2 rounded-full bg-theme-base-900 px-2 py-0.5 text-xs text-white" data-cart-count>0</span>
		</a>
	</div>
</nav>
