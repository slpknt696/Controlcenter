---
import '@fontsource-variable/inter';
import SEO from '~/components/layout/SEO.astro';
import SiteFooter from '~/components/layout/SiteFooter.astro';
import SiteHeader from '~/components/layout/SiteHeader.astro';
import SiteRibbon from '~/components/layout/SiteRibbon.astro';
import { assetUrl } from '~/lib/asset-base.js';
import '../styles.css';

const defaults = {
	name: 'Control Center',
	description: 'Catalogo local de accesorios, tecnologia y servicio tecnico.',
	image: {
		src: new URL('/assets/brand/banner.webp', Astro.site).href,
		alt: 'Control Center',
	},
} as const;

type Props = {
	title: string;
};

const { title } = Astro.props;
---

<html lang="es" class="overflow-x-clip bg-white text-theme-base-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
		<link rel="mask-icon" href={assetUrl('/favicon.svg')} color="#8D46E7" />

		<SEO {...defaults} {title} />
	</head>
	<body class="content-grid min-h-screen">
		<SiteRibbon />
		<div class={`breakout border-b w-full border-theme-base-300`}></div>
		<SiteHeader />
		<div class={`breakout border-b w-full border-theme-base-300`}></div>
		<slot />
		<div class="pt-48">
			<SiteFooter />
		</div>
	</body>
</html>

<script>
	import { addToCart, summarizeCart } from '../utils/cartLogic.js';

	const money = (value) => '$' + new Intl.NumberFormat('es-AR').format(Math.round(Number(value) || 0));

	function updateCartBadges() {
		const summary = summarizeCart();
		document.querySelectorAll('[data-cart-count]').forEach((element) => {
			element.textContent = String(summary.count);
		});
		document.querySelectorAll('[data-cart-total-label]').forEach((element) => {
			element.textContent = money(summary.total);
		});
	}

	document.addEventListener('click', (event) => {
		const button = event.target.closest('[data-add-cart]');
		if (!button) return;
		try {
			const product = JSON.parse(button.dataset.product || '{}');
			addToCart(product, 1);
			updateCartBadges();
			button.textContent = 'Agregado';
			window.setTimeout(() => {
				button.textContent = button.dataset.label || 'Agregar';
			}, 900);
		} catch {
			button.textContent = 'Error';
		}
	});

	window.addEventListener('control-center-cart-updated', updateCartBadges);
	document.addEventListener('astro:page-load', updateCartBadges);
	updateCartBadges();
</script>
