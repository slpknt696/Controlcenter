---
import CollectionSection from '~/features/collection/CollectionSection.astro';
import PrimaryLayout from '~/layouts/PrimaryLayout.astro';

export const prerender = true;
---

<PrimaryLayout title="Pagina no encontrada | Control Center">
	<main>
		<div class="mx-auto my-16 grid max-w-xl lg:my-32">
			<h1 class="mb-6 text-3xl font-semibold sm:text-5xl">No encontramos esa pagina.</h1>
			<p>
				La ruta no existe en este prototipo local. Volver al <a class="font-semibold underline" href="/">inicio.</a>
			</p>
		</div>
		<CollectionSection heading="Comprar por categoria" />
	</main>
</PrimaryLayout>
