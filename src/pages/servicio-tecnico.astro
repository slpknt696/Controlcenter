---
import PrimaryLayout from '~/layouts/PrimaryLayout.astro';
---

<PrimaryLayout title="Servicio tecnico | Control Center">
	<main class="breakout py-12">
		<section class="content grid gap-8 lg:grid-cols-[1fr_1fr]">
			<div>
				<p class="text-sm font-bold uppercase text-theme-base-500">Servicio tecnico</p>
				<h1 class="mt-2 text-4xl font-extrabold text-theme-base-900">Diagnostico y reparacion</h1>
				<p class="mt-4 text-theme-base-600">Diagnostico, reparacion y mantenimiento para celulares, computadoras, notebooks y consolas.</p>
			</div>
			<div class="grid gap-4">
				<article class="bg-theme-base-100 p-6"><h2 class="text-2xl font-bold">Celulares</h2><p class="mt-2 text-theme-base-600">Pin de carga, pantallas, baterias y software.</p></article>
				<article class="bg-theme-base-100 p-6"><h2 class="text-2xl font-bold">PC y notebooks</h2><p class="mt-2 text-theme-base-600">Mantenimiento, optimizacion, backup e instalacion.</p></article>
				<article class="bg-theme-base-100 p-6"><h2 class="text-2xl font-bold">Consolas</h2><p class="mt-2 text-theme-base-600">Limpieza, diagnostico y accesorios compatibles.</p></article>
			</div>
		</section>
	</main>
</PrimaryLayout>
